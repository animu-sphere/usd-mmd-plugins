# PMX fixtures are binary: never apply text/EOL conversion. A PMX string is a
# length-prefixed byte run, so a single converted byte moves every offset after
# it and the file no longer parses.
*.pmx binary

# The texture files the generator writes beside the fixtures are images, and
# compared byte for byte like the fixtures. `.sph` and `.spa` are MMD's names
# for an image used as a sphere map; the packaging fixtures add TGA, JPEG and
# GIF.
*.png binary
*.bmp binary
*.sph binary
*.spa binary
*.tga binary
*.jpg binary
*.gif binary

# The fixture manifest is compared byte for byte with what the generator writes
# (`generate_fixtures.py --check`), and the generator writes '\n'.
fixtures.json text eol=lf

# The generated CP932 table is compared byte for byte with what its generator
# writes (`generate_cp932_table.py --check`), and the generator writes '\n'.
Cp932Table.inc text eol=lf

# USDA goldens and fixtures check out with LF everywhere. A CRLF smudge changes
# the *content* of a multi-line (triple-quoted) string -- the \r becomes part of
# the parsed value -- so a Windows checkout would flatten to different bytes
# than the committed golden (usd-vrm-plugins, PR #42).
*.usda text eol=lf

# mmdSchema's committed usdGenSchema output is compared byte for byte with what
# its generator writes (`generate_schema.py --check`), and the generator writes
# '\n' whatever usdGenSchema's host wrote.
plugins/mmdSchema/src/mmdSchema/* text eol=lf
plugins/mmdSchema/plugin/resources/mmdSchema/plugInfo.json.in text eol=lf
