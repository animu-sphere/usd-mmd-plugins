@PACKAGE_INIT@
set(mmdPhysicsAdapter_BODY_PROPERTIES_VERSION 1)
set(mmdPhysicsAdapter_SOURCE_DAMPING_VERSION 1)
set(mmdPhysicsAdapter_SOURCE_BODY_PROPERTIES_VERSION 1)
set(mmdPhysicsAdapter_JOINT_SPRINGS_VERSION 1)
set(mmdPhysicsAdapter_INITIAL_POSE_VERSION 1)
include(CMakeFindDependencyMacro)
if(NOT TARGET mmdControl::mmdControl)
    find_dependency(mmdControl CONFIG)
endif()
if(NOT TARGET usd AND NOT TARGET pxr::usd AND NOT TARGET usd_ms)
    find_dependency(pxr CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/mmdPhysicsAdapterTargets.cmake")
check_required_components(mmdPhysicsAdapter)
