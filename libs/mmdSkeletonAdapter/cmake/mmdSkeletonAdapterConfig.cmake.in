@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT TARGET mmdModel::mmdModel)
    find_dependency(mmdModel CONFIG)
endif()
if(NOT TARGET motionRetarget::motionRetarget)
    find_dependency(motionRetarget 0.5.3 CONFIG)
endif()
# A static library's private link still reaches its consumers' link line.
if(NOT TARGET motionSource::motionSource)
    find_dependency(motionSource 0.5.2 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/mmdSkeletonAdapterTargets.cmake")
check_required_components(mmdSkeletonAdapter)
